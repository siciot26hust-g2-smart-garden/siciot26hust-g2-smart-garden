  {
    "id": "d770171acc44971f",
    "type": "function",
    "z": "d2d5a5906a7e4dcf",
    "name": "Handshake (Ready)",
    "func": "// Constantly send heartbeat\nlet t = msg.payload;\nif (typeof t === 'string') {\n    try { t = JSON.parse(t); } catch(e) { return null; }\n}\nif (!t || !t.seq) return null;\n\nreturn {\n    topic: 'garden/pi/ready',\n    payload: String(t.seq)\n};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
