  {
    "id": "9659123b55c64cbe",
    "type": "function",
    "z": "d2d5a5906a7e4dcf",
    "name": "Build session|sequence command",
    "func": "const session=flow.get('esp32_session');\nif(!session){node.status({fill:'red',shape:'ring',text:'No ESP32 session'});return null;}\nconst topic=String(msg.topic||'');\nconst value=String(msg.payload||'');\nif(!topic||!value)return null;\nlet seqs=flow.get('cmd_seq')||{};\nlet seq=seqs[topic];\nlet timeSeq=Math.floor((Date.now()-1790000000000)/100);\nif(!seq||seq<timeSeq)seq=timeSeq;\nelse seq=seq+1;\nseqs[topic]=seq;\nflow.set('cmd_seq',seqs);\nmsg.payload=`${session}|${seq}|${value}`;\nnode.status({fill:'green',shape:'dot',text:`${topic} seq ${seq}`});\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 620,
    "wires": [
      [
        "dc1774cd84d1451c",
        "debug_mqtt_out"
      ]
    ]
  },
