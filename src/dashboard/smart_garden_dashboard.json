  {
    "id": "7e548f1e44a916da",
    "type": "function",
    "z": "d2d5a5906a7e4dcf",
    "name": "Auto Controller (Pi Logic)",
    "func": "if (!flow.get('auto_state')) return null;\nif (!flow.get('pi_mode')) return null; // Wait until Pi has control\n\nlet t = msg.payload;\nif (typeof t === 'string') {\n    try { t = JSON.parse(t); } catch(e) { return null; }\n}\nif (!t) return null;\n\nlet msgs = [];\nlet last_pump = flow.get('last_pi_pump');\nlet last_servo = flow.get('last_pi_servo');\n\nif (t.soil !== null && t.soil !== undefined && t.soil !== 'null') {\n    let soil = parseFloat(t.soil);\n    let pump_cmd = null;\n    if (soil < 30) pump_cmd = 'ON';\n    else if (soil >= 60) pump_cmd = 'OFF';\n    \n    if (pump_cmd && pump_cmd !== last_pump) {\n        flow.set('last_pi_pump', pump_cmd);\n        msgs.push({ topic: 'garden/pi/pump', payload: pump_cmd });\n    }\n}\n\nif (t.temp !== null && t.temp !== undefined && t.temp !== 'null') {\n    let temp = parseFloat(t.temp);\n    let servo_cmd = null;\n    if (temp > 32) servo_cmd = 'OPEN';\n    else if (temp < 28) servo_cmd = 'CLOSE';\n    \n    if (servo_cmd && servo_cmd !== last_servo) {\n        flow.set('last_pi_servo', servo_cmd);\n        msgs.push({ topic: 'garden/pi/servo', payload: servo_cmd });\n    }\n}\n\nif (msgs.length > 0) return [msgs];\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 1150,
    "wires": [
      [
        "9659123b55c64cbe"
      ]
    ]
  },
