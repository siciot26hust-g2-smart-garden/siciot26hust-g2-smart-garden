    "type": "function",
    "z": "d2d5a5906a7e4dcf",
    "name": "Store ESP32 session",
    "func": "const s=String(msg.payload||'').trim();\nif(s){\n  const old=flow.get('esp32_session');\n  flow.set('esp32_session',s);\n  if(old!==s)flow.set('cmd_seq',{});\n}\nmsg.payload=s||'UNKNOWN';\nreturn msg;",
