  {
    "id": "c49b033f6dac4475",
    "type": "function",
    "z": "d2d5a5906a7e4dcf",
    "name": "Format telemetry",
    "func": "let t=msg.payload;\nif(typeof t==='string'){try{t=JSON.parse(t)}catch(e){msg.payload=String(t);return msg;}}\nif(!t||typeof t!=='object')return null;\nconst age=v=>v===4294967295?'N/A':(Number(v)/1000).toFixed(1)+' s';\nmsg.payload=`seq=${t.seq ?? '-'} | uptime=${t.uptime_ms ?? '-'} ms | soil age=${age(t.soil_age_ms)} | DHT age=${age(t.dht_age_ms)} | water age=${age(t.water_age_ms)}`;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
