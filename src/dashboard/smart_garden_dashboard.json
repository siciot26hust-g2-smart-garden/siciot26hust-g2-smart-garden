    "name": "Build Heartbeat",
    "func": "const session = flow.get('esp32_session');\nif (!session) return null;\nlet counter = flow.get('hb_counter') || 0;\ncounter++;\nflow.set('hb_counter', counter);\nreturn {\n    topic: 'garden/pi/heartbeat',\n    payload: session + '|' + counter\n};",
