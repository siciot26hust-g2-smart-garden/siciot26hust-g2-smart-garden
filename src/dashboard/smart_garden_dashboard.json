  {
    "id": "49ce4ea1ac5cc600",
    "type": "function",
    "z": "d2d5a5906a7e4dcf",
    "name": "Smart Auto Override (15s)",
    "func": "const cmdMsg = Object.assign({}, msg);\n\nconst resetMsg = { topic: 'garden/control/reset', payload: 'RESET' };\nconst autoOffMsg = { topic: 'garden/control/auto', payload: 'OFF' };\nconst autoOnMsg = { topic: 'garden/control/auto', payload: 'ON' };\n\nnode.send([ [autoOffMsg, resetMsg, cmdMsg] ]);\n\nif (context.get('autoTimer')) {\n    clearTimeout(context.get('autoTimer'));\n}\n\nconst timeout = setTimeout(() => {\n    node.send([ [autoOnMsg] ]);\n    context.set('autoTimer', null);\n}, 15000); \n\ncontext.set('autoTimer', timeout);\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 700,
    "wires": [
